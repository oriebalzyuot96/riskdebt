{
  "placeholders": ["example", "your", "changeme", "placeholder", "xxxx", "dummy", "sample"],
  "patterns": [
    {"id": "aws-access-key", "name": "AWS access key ID", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b", "severity": "critical"},
    {"id": "github-token", "name": "GitHub token", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b", "severity": "critical"},
    {"id": "anthropic-key", "name": "Anthropic API key", "pattern": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}", "severity": "critical"},
    {"id": "openai-key", "name": "OpenAI API key", "pattern": "\\bsk-proj-[A-Za-z0-9_\\-]{32,}|\\bsk-[A-Za-z0-9]{48}\\b", "severity": "critical"},
    {"id": "slack-token", "name": "Slack token", "pattern": "\\bxox[abprs]-[A-Za-z0-9\\-]{10,}", "severity": "critical"},
    {"id": "google-api-key", "name": "Google API key", "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}", "severity": "high"},
    {"id": "private-key", "name": "private key", "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----", "severity": "critical"},
    {"id": "generic-secret", "name": "hard-coded credential", "pattern": "(?:api[_-]?key|secret|token|passwd|password)[\"']?\\s*[:=]\\s*[\"'][A-Za-z0-9/+_\\-]{16,}[\"']", "flags": "i", "severity": "high", "skipPlaceholders": true}
  ]
}
